{
  "name": "@zeroopensource/zero-id",
  "version": "0.0.5",
  "description": "Utility for generating random hexadecimal IDs",
  "author": "Jigz <jigzpalillo@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/zeroopensource/zero-id",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeroopensource/zero-id.git"
  },
  "bugs": {
    "url": "https://github.com/zeroopensource/zero-id/issues"
  },
  "type": "module",
  "types": "./dist/index.d.cts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node -e \"require('fs').copyFileSync('../../README.md', 'README.md')\"",
    "lint": "cross-env TIMING=1 eslint \"**/*.ts*\"",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "generate": "tsx src/generate.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "tsx": "^4.21.0",
    "date-fns": "^4.1.0",
    "nanoid": "5.1.7",
    "commander": "^14.0.3",
    "@zeroopensource/zero-cli": "latest"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./generate": {
      "import": "./dist/generate.mjs",
      "require": "./dist/generate.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs"
}
